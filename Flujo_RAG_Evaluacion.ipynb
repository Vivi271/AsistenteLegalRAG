    "\norte",
    "# RAGAs necesita el mismo LLM y embeddings como \"juez\" interno\n",
    "llm_juez = LangchainLLMWrapper(llm)\n",
    "embeddings_juez = LangchainEmbeddingsWrapper(embeddings_model)\n",
    "\norte",
    "# Construir el conjunto de datos en formato RAGAs\n",
    "dataset = EvaluationDataset.from_list(registros)\n",
    "\norte",
    "print(\"Evaluando con RAGAs (consumir tokens adicionales)...\\n\")\n",
    "\norte",
    "resultados = evaluar(\n",
    " dataset=dataset,\n",
    " métricas=[\n",
    "fidelidad, #La respuesta solo usa informacion del contexto\n",
    " respuesta_relevancia, # La respuesta es pertinente a la pregunta\n",
    " context_precision, # Los fragmentos recuperados son utiles\n",
    " ],\n",
    " llm=llm_juez,\n",
    " incrustaciones=incrustaciones_juez\n",
    ")\norte",
    "\norte",
    "# Mostrar resultados\n",
    "df = resultados.to_pandas()\n",
    "\norte",
    "print(\"=\" * 65)\n",
    "print(\"RESULTADOS DE EVALUACION RAGAs\")\n",
    "print(\"=\" * 65)\n",
