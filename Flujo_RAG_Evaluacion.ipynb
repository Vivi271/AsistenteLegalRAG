   ],
   "fuente": [
    "def rag_pipeline(pregunta: str, k: int = 5, detallado: bool = False) -> dict:\n",
    " '''\n",
    " Pipeline RAG de extremo a extremo.\n",
    "\norte",
    " Pasos:\n",
    " 1. Recuperar k fragmentos relevantes del vector store\n",
    " 2. Ensamblar el contexto\n",
    " 3. Construir el mensaje aumentado\n",
    " 4. Generar respuesta con el LLM\n",
    "\norte",
    " Argumentos:\n",
    " pregunta: consulta del usuario en lenguaje natural\n",
    " k: número de fragmentos a recuperar (predeterminado 5)\n",
    " detallado: mostrar fragmentos recuperados\n",
    "\norte",
    " Devuelve:\n",
    " dict con pregunta, fragmentos, contexto y respuesta\n",
    " '''\n",
    " # Paso 1: Recuperar fragmentos relevantes\n",
    " retriever_k = vector_store.as_retriever(\n",
    " search_type='similarity',\n",
    " search_kwargs={'k': k}\n",
    " )\n",
    "docs = retriever_k.invoke(pregunta)\n",
    "\norte",
    " # Paso 2: Ensamblar contexto\n",
    " contexto = '\\n\\n---\\n\\n'.join(\n",
    " f'[Fragmento {i+1} — Pág. {d.metadata.get(\"page\",\"?\")}]\\n{d.page_content}'\n",
    " para i, d en enumerate(docs)\n",
    " )\n",
    "\norte",
    " # Paso 3: Construir mensaje aumentado\n",
    " prompt = prompt_template.invoke({'context': contexto, 'question': pregunta})\n",
    "\norte",
    " # Paso 4: Generar respuesta\n",
    " respuesta_llm = llm.invoke(prompt)\n",
    " si isinstance(respuesta_llm.content, lista):\n",
    " texto = respuesta_llm.content[0].get('texto', '')\n",
    " de lo contrario:\n",
    " texto = respuesta_llm.content\n",
    "\norte",
    " si es detallado:\n",
    " print(f'Fragmentos recuperados: {len(docs)}')\n",
    " para i, d en enumerate(docs, 1):\n",
    " fuente = os.path.basename(d.metadata.get('source', '?'))\n",
    " pagina = d.metadata.get('page', '?')\n",
    " print(f' [{i}] {fuente} Pág.{pagina}: {d.page_content[:80]}....')\n",
    "\norte",
    " devolver {\n",
    " 'pregunta': pregunta,\n",
    " 'fragmentos': documentos,\n",
    " 'contexto': contexto,\n",
    " 'respuesta': texto,\n",
    " 'tokens_contexto_aprox': len(contexto) // 4\n",
    " }\n",
    "\norte",
    "print('Función rag_pipeline() lista.')\n",
    "print('Uso: resultado = rag_pipeline(\"tu pregunta aquí\")')"
   ]
  },
